<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".HanapAralApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HanapAral">

        <activity
            android:name=".ui.main.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:label="My Profile" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:label="Edit Profile" />

        <activity
            android:name=".ui.groups.GroupListActivity"
            android:exported="false"
            android:label="Study Groups" />

        <activity
            android:name=".ui.groups.CreateGroupActivity"
            android:exported="false"
            android:label="Create Group" />

        <activity
            android:name=".ui.groups.GroupDetailsActivity"
            android:exported="false"
            android:label="Group Details" />

        <activity
            android:name=".ui.admin.AdminPanelActivity"
            android:exported="false"
            android:label="Admin Panel"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.groups.CreateGroupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.groups.GroupListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.groups.GroupDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminPanelActivity"
            android:exported="false" />

    </application>

</manifest>